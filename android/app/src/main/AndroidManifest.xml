<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <application
      android:label="Weather"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:allowBackup="false"
      android:usesCleartextTraffic="false">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service
        android:name=".WeatherJob"
        android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver android:name=".Widgets$Now" android:exported="false" android:label="@string/widget_name_now">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now" />
    </receiver>
    <receiver android:name=".Widgets$Pilot" android:exported="false" android:label="@string/widget_name_pilot">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pilot" />
    </receiver>
    <receiver android:name=".Widgets$Glance" android:exported="false" android:label="@string/widget_name_glance">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_glance" />
    </receiver>
    <receiver android:name=".Widgets$Hours" android:exported="false" android:label="@string/widget_name_hours">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hours" />
    </receiver>
    <receiver android:name=".Widgets$Days" android:exported="false" android:label="@string/widget_name_days">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_days" />
    </receiver>
    <receiver android:name=".Widgets$Tide" android:exported="false" android:label="@string/widget_name_tide">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tide" />
    </receiver>
    <receiver android:name=".Widgets$Minimal" android:exported="false" android:label="@string/widget_name_minimal">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_minimal" />
    </receiver>
    <provider
        android:name=".WidgetImages"
        android:authorities="com.weather.app.widgetimg"
        android:exported="true" />
  </application>
</manifest>
