<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <TextView android:id="@+id/widget_msg"
      android:layout_width="match_parent" android:layout_height="match_parent"
      android:gravity="center" android:padding="12dp"
      android:background="@drawable/widget_bg"
      android:text="Weather · loading…" android:textColor="#B4C3D4" android:textSize="14sp" />
  <ImageView android:id="@+id/widget_img"
      android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitXY" android:contentDescription="Weather" />
</FrameLayout>
